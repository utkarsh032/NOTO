{
  // Cloudflare Workers configuration for the Noto web application.
  //
  // A second, separate Workers project from the website: the two are deployed
  // independently, and the marketing site should never be able to take the
  // application down with it.
  //
  //   build:  pnpm build:web
  //   deploy: npx wrangler deploy --config apps/web/wrangler.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noto-web",
  "compatibility_date": "2026-08-15",

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  }
}
