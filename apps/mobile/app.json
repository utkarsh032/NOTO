{
  "expo": {
    "name": "Noto",
    "slug": "noto",
    "version": "0.1.0-beta.2",
    "orientation": "portrait",
    "scheme": "noto",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noto.app",
      "buildNumber": "1000"
    },
    "android": {
      "package": "com.noto.app",
      "edgeToEdgeEnabled": true,
      "versionCode": 1000
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
