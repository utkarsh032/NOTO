{
  "expo": {
    "name": "Noto",
    "slug": "noto",
    "version": "1.1.4",
    "orientation": "portrait",
    "scheme": "noto",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noto.app",
      "buildNumber": "1001004"
    },
    "android": {
      "package": "com.noto.app",
      "edgeToEdgeEnabled": true,
      "versionCode": 1001004
    },
    "plugins": [
      "expo-router",
      "./plugins/with-android-release-signing.cjs",
      "./plugins/with-android-app-size.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
