{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "env": ["NOTO_TEST_DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_SERVICE_URL",
        "DATABASE_MIGRATE_URL",
        "JWT_SECRET"
      ]
    }
  }
}
