# apps/api/.env — copy to .env (ignored by git). See docs/development/database.md.

# As noto_api: every request. Row-level security applies.
DATABASE_URL=postgres://noto_api:change-me-locally@localhost:5432/noto
# As noto_service: the server's own identity tables. Bypasses RLS.
DATABASE_SERVICE_URL=postgres://noto_service:change-me-locally@localhost:5432/noto
# The database owner. Used by db:bootstrap and db:migrate only, never by the server.
DATABASE_MIGRATE_URL=postgres://postgres:your-postgres-password@localhost:5432/noto

# At least 32 characters. `node -e "console.log(crypto.randomBytes(48).toString('base64url'))"`
JWT_SECRET=

# Development: any localhost origin may call the API, and the socket address is the client.
NOTO_ALLOW_LOCALHOST_ORIGINS=true
NOTO_CLIENT_IP_HEADER=none
NOTO_WEB_APP_URL=http://localhost:5173

# Unset in development: sign-up skips the bot check and mail prints to the terminal.
# Both are required when NODE_ENV=production.
# TURNSTILE_SECRET=
# TURNSTILE_HOSTNAMES=noto.app,www.noto.app
# RESEND_API_KEY=
# MAIL_FROM=Noto <no-reply@noto.app>

# PORT=8787
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=30d
