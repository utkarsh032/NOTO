{
  "name": "noto",
  "version": "0.0.0",
  "private": true,
  "description": "Noto — a local-first notes and document workspace for Web, Desktop and Mobile.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@noto/web",
    "dev:desktop": "turbo run dev --filter=@noto/desktop",
    "dev:mobile": "turbo run start --filter=@noto/mobile",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yaml,yml,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yaml,yml,css,html}\""
  },
  "devDependencies": {
    "@noto/eslint-config": "workspace:*",
    "@noto/prettier-config": "workspace:*",
    "@noto/tsconfig": "workspace:*",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
